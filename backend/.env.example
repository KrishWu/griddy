# Copy to backend/.env (git-ignored) and fill in only what your workstream needs.
# Read in code with os.environ.get("NAME"); never hard-code keys.
EIA_API_KEY=            # B/C: https://www.eia.gov/opendata/
NLR_API_KEY=DEMO_KEY    # B: PVWatts / NSRDB at developer.nlr.gov (DEMO_KEY is rate-limited)
WATTTIME_USERNAME=      # B/E: https://docs.watttime.org
WATTTIME_PASSWORD=
AIRNOW_API_KEY=         # E: https://docs.airnowapi.org/
EE_PROJECT=             # E: Google Cloud project registered for Earth Engine
EE_SERVICE_ACCOUNT_KEY= # E: path to a service-account JSON key, kept outside the repo; blank = use `earthengine authenticate`
PLANET_API_KEY=         # E: Planet education access
